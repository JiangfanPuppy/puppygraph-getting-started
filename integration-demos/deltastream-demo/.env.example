# Confluent Cloud: Cluster settings -> Bootstrap server; API keys -> Add key
CONFLUENT_BOOTSTRAP_SERVERS=<pkc-xxxxx.us-east-1.aws.confluent.cloud:9092>
CONFLUENT_API_KEY=<confluent-api-key>
CONFLUENT_API_SECRET=<confluent-api-secret>

# Databricks variant, read by PuppyGraph through schema_databricks.json
DATABRICKS_HOST=<dbc-xxxxxxxx-xxxx.cloud.databricks.com>
DATABRICKS_TOKEN=<databricks-personal-access-token>
DATABRICKS_S3_ACCESSKEY=<aws-access-key-id-for-the-bucket>
DATABRICKS_S3_SECRETKEY=<aws-secret-access-key-for-the-bucket>

# Snowflake variant, read by PuppyGraph through schema_snowflake.json
SNOW_USER=<snowflake-user>
SNOW_PWD=<snowflake-password>
SNOW_ACCOUNT_ID=<orgname-accountname>
